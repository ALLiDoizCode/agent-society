# Townhouse hidden-service mode — chain endpoint configuration.
#
# This file configures `docker-compose-townhouse-hs.yml` and the Akash deploy
# of the same stack (`scripts/akash-deploy.sh townhouse`). Both read the SAME
# variables, so a single .env configures laptop and Akash deploys identically.
#
# Copy to `.env` and uncomment ONE of the four profiles below:
#   cp .env.townhouse-hs.example .env
#
# All variables are optional with localnet defaults baked into the compose
# file. Leaving the file empty is equivalent to the "localnet" profile.

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Profile 1 — LOCALNET (default)                                          ║
# ║ Bundled Anvil + Solana test-validator. No external chain dependencies.  ║
# ║ Mock USDC contracts pre-deployed; faucet keys are Anvil/dev defaults.   ║
# ║ Boot with `--profile localnet --profile faucet`.                        ║
# ╚══════════════════════════════════════════════════════════════════════════╝
EVM_RPC_URL=http://anvil:8545
EVM_CHAIN_ID=31337
EVM_USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
SOLANA_RPC_URL=http://solana:8899
SOLANA_USDC_MINT=6GbdrVghwNKTz9raga7y3Y4qqX5Zgg3AC4d48Kt7C59Q

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Profile 2 — AKASH DEVNET                                                ║
# ║ Chain devnets deployed as separate Akash leases — see anvil.sdl.yaml +  ║
# ║ solana.sdl.yaml. Run `scripts/akash-deploy.sh anvil` and `solana` to    ║
# ║ provision them; URLs land in `deploy/akash/leases.json`. The Mock USDC  ║
# ║ contracts are baked into the Akash images — same addresses as localnet. ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# EVM_RPC_URL=https://<anvil-lease-host>           # from leases.json .anvil.url
# EVM_CHAIN_ID=31337
# EVM_USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# SOLANA_RPC_URL=http://<solana-lease-host>:<port> # from leases.json .solana.url
# SOLANA_USDC_MINT=6GbdrVghwNKTz9raga7y3Y4qqX5Zgg3AC4d48Kt7C59Q

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Profile 3 — PUBLIC TESTNET (Sepolia + Solana devnet)                    ║
# ║ Real testnet RPCs, real testnet USDC contracts. Bring your own funded   ║
# ║ wallets — the bundled faucet container drips Anvil-key-signed txs and   ║
# ║ will NOT work against real chains. Use chain-native faucets             ║
# ║ (sepoliafaucet.com, faucet.solana.com, Circle's CCTP testnet faucet).   ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# EVM_RPC_URL=https://sepolia.infura.io/v3/<YOUR_KEY>
# EVM_CHAIN_ID=11155111
# EVM_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238  # Sepolia USDC (Circle)
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU  # Solana devnet USDC (Circle)

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Profile 4 — MAINNET                                                     ║
# ║ Real money. Real consequences. The faucet container should NOT be       ║
# ║ enabled here (omit `--profile faucet`). Mill settles real channels.     ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# EVM_RPC_URL=https://mainnet.infura.io/v3/<YOUR_KEY>
# EVM_CHAIN_ID=1
# EVM_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48  # Mainnet USDC (Circle)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v  # Mainnet USDC (Circle)

# ── Optional: faucet drip amounts (default: 100 ETH, 10000 USDC, 1h cooldown) ──
# FAUCET_ETH_AMOUNT=100
# FAUCET_TOKEN_AMOUNT=10000
# FAUCET_RATE_LIMIT_HOURS=1

# ── Optional: ArDrive Turbo token for paid Arweave uploads (free <100 KiB) ──
# TURBO_TOKEN=
